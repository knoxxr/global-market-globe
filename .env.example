# ==============================================================================
# Global Market Globe — Environment Variables (Vercel Ready)
# ==============================================================================
# If neither POLYGON_API_KEY nor FINNHUB_API_KEY is configured, the app runs in
# Session-Aware Demo Stream mode automatically so previews work immediately.

# 1. Market Data Providers (configure one or both for live data + auto-failover)
POLYGON_API_KEY=
FINNHUB_API_KEY=

# 2. Shared Distributed Cache (Recommended for high-concurrency Vercel deployments)
# Create a free Upstash Redis DB via Vercel Marketplace to share 1 upstream fetch
# across all edge regions and serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 3. Cache & Rate-Limit Tuning (seconds)
# Controls how often the backend is allowed to call Polygon/Finnhub globally.
MARKET_CACHE_TTL_SECONDS=20

# 4. Vercel Cron Protection (auto-verified when /api/cron/refresh is invoked)
CRON_SECRET=
